function CE_FEM_Interactive_WaterJet_90Deg_Fixed()
% =========================================================================
% CIRCULAR ELEMENT FEM — WATER JET ENGINE (0° TO 90° FULL SPECTRUM SOLVER)
% =========================================================================
%
% 90-DEGREE & HIGH-ANGLE FIXES:
%   1. Parametric Trajectory Engine (x(t), y(t)): Prevents cos(90°) = 0 div-by-zero.
%   2. Fountain Plume Hydrodynamics: Natural lateral expansion at vertical apex.
%   3. Adaptive Diagnostic Plotting: Plots vs Height Y when theta > 80 deg.
%   4. Exact Area Conservation: pi*a*b = pi*R0^2 maintained at 10^-16 precision.
% =========================================================================

    clear; clc; close all;
    fprintf('╔══════════════════════════════════════════════════════════╗\n');
    fprintf('║  CE-FEM WATER JET ENGINE (0° TO 90° ROBUST SOLVER)       ║\n');
    fprintf('║  Parametric Ballistics & Hydrodynamic Fountain Plumes    ║\n');
    fprintf('╚══════════════════════════════════════════════════════════╝\n\n');

    outDir = fullfile(pwd, 'CE_FEM_WaterJet_Results');
    if ~exist(outDir, 'dir'), mkdir(outDir); end

    %% 1. INTERACTIVE SIMULATION CONTROLS DIALOG
    prompt = { ...
        '1. Jet Elevation Angle (Degrees) [0 to 90]:', ...
        '2. Jet Velocity (m/s) [e.g. 10 to 25]:', ...
        '3. Element Radius R0 (m) [e.g. 0.08 for fast, 0.05 for fine]:', ...
        '4. Nozzle Width (m) [e.g. 0.5 to 1.5]:', ...
        '5. Total Simulation Time (s) [e.g. 5.0]:' ...
    };
    dlgtitle = 'CE-FEM Water Jet Controls';
    fieldsize = [1 60];
    definput = {'90.0', '16.0', '0.08', '0.8', '5.0'};

    answer = inputdlg(prompt, dlgtitle, fieldsize, definput);
    if isempty(answer), disp('Canceled by user.'); return; end

    jet_angle_deg = str2double(answer{1});
    V_jet         = str2double(answer{2});
    R0            = str2double(answer{3});
    nozzle_width  = str2double(answer{4});
    t_max         = str2double(answer{5});

    %% 2. DOMAIN & PHYSICS PARAMETERS
    L_domain  = 40.0;     % Total domain length (m)
    H_domain  = 25.0;     % Total domain height (m)
    
    % Nozzle Position (Centered if 90 deg, left if lower angle)
    if jet_angle_deg > 80.0
        x_nozzle = L_domain / 2.0; % Center at X = 20 m for vertical fountain
    else
        x_nozzle = 3.0;            % Left side for parabolic arcs
    end
    y_nozzle  = 2.0;               % Nozzle Y (m)
    
    jet_rad   = deg2rad(jet_angle_deg);
    
    % Fluid Properties
    rho0      = 1000.0;   % Fluid density (kg/m^3)
    g_grav    = 9.81;     % Gravity acceleration (m/s^2)
    
    % Numerical Constants
    k_push    = 6000.0;   % Particle repulsion stiffness
    k_press   = 12000.0;  % Internal fluid expansion stiffness
    tau_relax = 0.08;     % Viscoelastic memory time (s)
    c_air     = 0.015;    % Air drag coefficient
    dt        = 0.0015;   % Time step (s)

    %% 3. PREALLOCATE PARTICLE SYSTEM
    max_particles = 35000;
    pos    = zeros(max_particles, 2);
    vel    = zeros(max_particles, 2);
    force  = zeros(max_particles, 2);
    R_rad  = zeros(max_particles, 1);
    axis_a = zeros(max_particles, 1);
    axis_b = zeros(max_particles, 1);
    theta  = zeros(max_particles, 1);
    active = false(max_particles, 1);

    % Compute Injection Points across the Nozzle width
    n_dir = [cos(jet_rad), sin(jet_rad)];       % Flow direction
    t_dir = [-sin(jet_rad), cos(jet_rad)];      % Transverse direction
    
    spacing = 2.01 * R0;
    num_injectors = max(1, floor(nozzle_width / spacing));
    s_offsets = linspace(-nozzle_width/2 + R0, nozzle_width/2 - R0, num_injectors);
    
    inj_pts = zeros(num_injectors, 2);
    for i = 1:num_injectors
        inj_pts(i, :) = [x_nozzle, y_nozzle] + s_offsets(i) * t_dir;
    end

    fprintf('Water Jet Initialized:\n');
    fprintf('  Angle = %.1f° | Velocity = %.1f m/s | Nozzle X = %.1f m\n', ...
            jet_angle_deg, V_jet, x_nozzle);

    %% 4. GRAPHICS CANVAS SETUP
    hFig = figure('Name', 'CE-FEM Robust Water Jet Engine', 'Color', 'k', ...
                  'Position', [40, 40, 1350, 700]);
    hAx = axes('Parent', hFig, 'Color', [0.02, 0.02, 0.04]);
    hold(hAx, 'on'); axis(hAx, 'equal');
    axis(hAx, [-1.0, L_domain + 1.0, -1.0, H_domain + 1.0]);
    set(hAx, 'XColor', 'w', 'YColor', 'w');
    xlabel(hAx, 'X Position (m)', 'Color', 'w');
    ylabel(hAx, 'Y Height (m)', 'Color', 'w');

    % Render Domain Bounds
    plot(hAx, [0, L_domain, L_domain, 0, 0], [H_domain, H_domain, 0, 0, H_domain], ...
         'w-', 'LineWidth', 2.0);
     
    % Render Nozzle Block
    nozzle_base_x = [x_nozzle - 1.2, x_nozzle + 1.2, x_nozzle + 0.8, x_nozzle - 0.8];
    nozzle_base_y = [0, 0, y_nozzle, y_nozzle];
    fill(hAx, nozzle_base_x, nozzle_base_y, [0.4, 0.4, 0.4], 'EdgeColor', 'w', 'LineWidth', 1.5);

    % Patch Object for Real-Time Ellipse Rendering
    th_sample = linspace(0, 2*pi, 14);
    cos_t = cos(th_sample); sin_t = sin(th_sample);
    hEllipses = patch('Parent', hAx, 'XData', NaN, 'YData', NaN, ...
                      'FaceColor', [0.15, 0.75, 1.00], 'FaceAlpha', 0.85, ...
                      'EdgeColor', [0.05, 0.30, 0.60], 'LineWidth', 0.1);

    %% 5. MAIN TIME INTEGRATION LOOP
    inflow_timer = 0.0;
    sim_time     = 0.0;
    step         = 0;

    t_inject_interval = spacing / V_jet;

    fprintf('Simulating jet flow...\n');
    tic;

    while sim_time < t_max && ishandle(hFig)
        step = step + 1;
        sim_time = sim_time + dt;
        inflow_timer = inflow_timer + dt;

        act_idx = find(active);
        N_act   = length(act_idx);

        % --- A. Continuous Injection ---
        if inflow_timer >= t_inject_interval && N_act < (max_particles - num_injectors)
            inflow_timer = inflow_timer - t_inject_interval; 
            
            for i = 1:num_injectors
                free_slot = find(~active, 1);
                if isempty(free_slot), break; end
                
                % Add slight random noise to injection for vertical fountain stability
                rand_kick = (rand(1,2) - 0.5) * 0.05 * (jet_angle_deg > 80);
                pos(free_slot, :)   = inj_pts(i, :) + rand_kick;
                vel(free_slot, :)   = V_jet * n_dir;
                R_rad(free_slot)    = R0;
                axis_a(free_slot)   = R0;
                axis_b(free_slot)   = R0;
                theta(free_slot)    = jet_rad;
                active(free_slot)   = true;
            end
            act_idx = find(active);
            N_act   = length(act_idx);
        end

        force(act_idx, :) = 0.0;

        % --- B. O(N) Spatial Cell-List Grid ---
        cell_size = 2.2 * R0;
        n_bx = ceil((L_domain + 2.0) / cell_size) + 1;
        n_by = ceil((H_domain + 2.0) / cell_size) + 1;
        head = zeros(n_bx, n_by, 'int32');
        next = zeros(max_particles, 1, 'int32');

        for idx = 1:N_act
            i = act_idx(idx);
            gx = min(n_bx, max(1, floor((pos(i,1) + 1.0) / cell_size) + 1));
            gy = min(n_by, max(1, floor((pos(i,2) + 1.0) / cell_size) + 1));
            next(i) = head(gx, gy);
            head(gx, gy) = i;
        end

        % --- C. Inter-Particle Contact & Pressure ---
        for idx = 1:N_act
            i = act_idx(idx);
            gx = min(n_bx, max(1, floor((pos(i,1) + 1.0) / cell_size) + 1));
            gy = min(n_by, max(1, floor((pos(i,2) + 1.0) / cell_size) + 1));

            for ox = -1:1
                for oy = -1:1
                    cx = gx + ox; cy = gy + oy;
                    if cx < 1 || cx > n_bx || cy < 1 || cy > n_by, continue; end
                    j = head(cx, cy);
                    while j > 0
                        if i < j
                            rij = pos(i,:) - pos(j,:);
                            d = norm(rij);
                            d_min = 0.98 * (R_rad(i) + R_rad(j));

                            if d < d_min && d > 1e-7
                                nrm = rij / d;
                                overlap = d_min - d;

                                % Hard Position Correction
                                shift = 0.40 * overlap * nrm;
                                pos(i,:) = pos(i,:) + shift;
                                pos(j,:) = pos(j,:) - shift;

                                % Repulsion + Fluid Pressure
                                rv = vel(i,:) - vel(j,:);
                                vn = dot(rv, nrm);
                                f_hertz = k_push * (overlap^1.2) + k_press * (overlap / R0);

                                force(i,:) = force(i,:) + f_hertz * nrm;
                                force(j,:) = force(j,:) - f_hertz * nrm;

                                if vn < 0
                                    vel(i,:) = vel(i,:) - 0.35 * vn * nrm;
                                    vel(j,:) = vel(j,:) + 0.35 * vn * nrm;
                                end
                            end
                        end
                        j = next(j);
                    end
                end
            end
        end

        % --- D. Ground & Wall Collisions ---
        for idx = 1:N_act
            i = act_idx(idx);
            px = pos(i,1); py = pos(i,2); r_i = R_rad(i);

            % Left Wall
            if px < r_i
                pos(i,1) = r_i;
                if vel(i,1) < 0, vel(i,1) = -0.3 * vel(i,1); end
            end
            % Right Wall
            if px > L_domain - r_i
                pos(i,1) = L_domain - r_i;
                if vel(i,1) > 0, vel(i,1) = -0.3 * vel(i,1); end
            end
            % Floor
            if py < r_i
                pos(i,2) = r_i;
                if vel(i,2) < 0, vel(i,2) = -0.15 * vel(i,2); end
            end
        end

        % --- E. Gravity Integration, Kinematics & Area Invariant ---
        for idx = 1:N_act
            i = act_idx(idx);
            
            mass_i = rho0 * pi * R_rad(i)^2;
            f_gravity = [0.0, -mass_i * g_grav];
            f_air_drag = -c_air * norm(vel(i,:)) * vel(i,:);

            total_acc = (force(i,:) + f_gravity + f_air_drag) / mass_i;
            
            vel(i,:) = vel(i,:) + total_acc * dt;
            
            spd = norm(vel(i,:));
            if spd > 35.0, vel(i,:) = vel(i,:) * (35.0 / spd); end
            
            pos(i,:) = pos(i,:) + vel(i,:) * dt;

            % Deletion if water flies out top
            if pos(i,2) > H_domain + 2.0
                active(i) = false; continue;
            end

            % Streamline Angle
            if spd > 0.1
                theta(i) = atan2(vel(i,2), vel(i,1));
            end

            % --- CE-FEM KINEMATICS ---
            if spd > 1.5
                speed_factor = min(4.0, max(1.0, spd / (V_jet * 0.35)));
                target_a = R_rad(i) * speed_factor;
            else
                target_a = R_rad(i);
            end
            
            axis_a(i) = axis_a(i) + 0.25 * (target_a - axis_a(i));
            axis_a(i) = max(0.60 * R_rad(i), min(4.5 * R_rad(i), axis_a(i)));

            % STRICT AREA INVARIANCE: pi * a * b = pi * R^2
            axis_b(i) = (R_rad(i)^2) / axis_a(i);
        end

        % --- F. Real-Time Rendering ---
        if mod(step, 12) == 0
            act_render = find(active);
            n_render = length(act_render);
            
            X_p = zeros(14, n_render);
            Y_p = zeros(14, n_render);
            
            for k = 1:n_render
                p_i = act_render(k);
                ct = cos(theta(p_i)); st = sin(theta(p_i));
                xe = axis_a(p_i) * cos_t; ye = axis_b(p_i) * sin_t;
                
                X_p(:, k) = pos(p_i, 1) + ct*xe - st*ye;
                Y_p(:, k) = pos(p_i, 2) + st*xe + ct*ye;
            end
            
            set(hEllipses, 'XData', X_p, 'YData', Y_p);
            title(hAx, sprintf('CE-FEM Water Jet | Angle: %.1f° | Speed: %.1f m/s | Time: %.2f s', ...
                  jet_angle_deg, V_jet, sim_time), 'Color', 'w', 'FontSize', 12);
            drawnow limitrate;
        end
    end

    t_sim = toc;
    fprintf('Jet simulation completed in %.2f seconds.\n\n', t_sim);

    %% 6. POST-PROCESSING DIAGNOSTIC SUITE
    render_jet_diagnostics_robust(pos, vel, axis_a, axis_b, R_rad, active, ...
                                  L_domain, H_domain, x_nozzle, y_nozzle, V_jet, jet_rad, jet_angle_deg, g_grav, outDir);
end

%% ========================================================================
% DIAGNOSTIC SUITE (PARAMETRIC & ADAPTIVE PLOTTING FOR 0° TO 90°)
% =========================================================================
function render_jet_diagnostics_robust(pos, vel, a, b, R, active, L, H, x0, y0, V0, theta0, angle_deg, g, outDir)
    act_i = find(active);
    if isempty(act_i), return; end
    
    x_p = pos(act_i, 1); y_p = pos(act_i, 2);
    v_x = vel(act_i, 1); v_y = vel(act_i, 2);
    v_mag = sqrt(v_x.^2 + v_y.^2);
    
    % --- Parametric Theoretical Trajectory (Prevents div-by-zero at 90 deg) ---
    t_flight_max = min(5.0, 2.0 * V0 * sin(theta0) / g + 0.1);
    if t_flight_max <= 0.1, t_flight_max = 3.0; end
    
    t_arr = linspace(0, t_flight_max, 250);
    x_theory = x0 + V0 * cos(theta0) * t_arr;
    y_theory = y0 + V0 * sin(theta0) * t_arr - 0.5 * g * t_arr.^2;
    
    valid_th = (y_theory >= 0 & x_theory >= 0 & x_theory <= L);
    x_theory = x_theory(valid_th);
    y_theory = y_theory(valid_th);

    fig = figure('Name', 'Water Jet Diagnostics', 'Color', 'w', 'Position', [80, 60, 1150, 780]);

    % 1. Velocity Field Map & Trajectory Comparison
    subplot(2, 2, 1);
    scatter(x_p, y_p, 10, v_mag, 'filled'); hold on;
    plot([0 L L 0 0], [H H 0 0 H], 'k-', 'LineWidth', 2.0);
    if ~isempty(x_theory)
        plot(x_theory, y_theory, 'r--', 'LineWidth', 2.5); % Parametric Arc
    end
    
    axis equal tight; xlim([0, L]); ylim([0, H]);
    colorbar; colormap(gca, 'turbo');
    xlabel('X (m)'); ylabel('Y (m)');
    legend('CE-FEM Fluid Parcels', 'Parametric Ballistic Arc', 'Location', 'best');
    title(sprintf('Velocity Field & Trajectory (\\theta = %.1f°)', angle_deg));
    
    % 2. Aspect Ratio Morphing (a/b)
    subplot(2, 2, 2);
    aspect = a(act_i) ./ b(act_i);
    scatter(x_p, y_p, 10, aspect, 'filled'); hold on;
    plot([0 L L 0 0], [H H 0 0 H], 'k-', 'LineWidth', 2.0);
    axis equal tight; xlim([0, L]); ylim([0, H]);
    colorbar; colormap(gca, 'jet');
    xlabel('X (m)'); ylabel('Y (m)');
    title('Streamline Thinning (a/b > 1.0)');

    % 3. Vertical Velocity Trajectory (Plotted vs Height Y if angle > 80 deg)
    subplot(2, 2, 3);
    if angle_deg > 80.0
        plot(v_y, y_p, 'c.', 'MarkerSize', 5); grid on;
        xlabel('Vertical Velocity v_y (m/s)'); ylabel('Height Y (m)');
        title('Vertical Velocity Profile v_y vs. Height Y');
    else
        plot(x_p, v_y, 'c.', 'MarkerSize', 5); grid on;
        xlabel('X Position (m)'); ylabel('Vertical Velocity v_y (m/s)');
        title('Gravity Deceleration & Fall v_y');
    end

    % 4. Exact Area Conservation Invariant Error Plot
    subplot(2, 2, 4);
    area_err = abs((a(act_i) .* b(act_i)) ./ (R(act_i).^2) - 1.0);
    if angle_deg > 80.0
        semilogy(y_p, area_err + 1e-20, 'k.', 'MarkerSize', 5); grid on;
        xlabel('Height Y (m)'); ylabel('|\pi ab / \pi R^2 - 1|');
    else
        semilogy(x_p, area_err + 1e-20, 'k.', 'MarkerSize', 5); grid on;
        xlabel('X Position (m)'); ylabel('|\pi ab / \pi R^2 - 1|');
    end
    title(sprintf('Mass Invariant Error (Max Error: %.2e)', max(area_err)));

    sgtitle(sprintf('CE-FEM Water Jet Engine | Angle = %.1f° | V_0 = %.1f m/s', ...
            angle_deg, V0), 'FontWeight', 'bold', 'FontSize', 14);
    
    savePath = fullfile(outDir, sprintf('WaterJet_Validation_%.0fDeg.png', angle_deg));
    try exportgraphics(fig, savePath, 'Resolution', 200); catch; print(fig, savePath, '-dpng'); end
    fprintf('Diagnostic plot saved to: %s\n', savePath);
end
